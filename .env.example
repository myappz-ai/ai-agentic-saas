# Copy to .env (never commit .env) or set these in your shell.
# .mcp.json reads PLATFORM_MCP_URL. If it is not set, the server points at a placeholder
# address and simply shows as not connected: nothing breaks and nothing is sent anywhere.
# The link can contain an access key: keep it out of chat, screenshots and git.
PLATFORM_MCP_URL=https://your-account-connection-link.example/mcp

# Optional: the app builder connector link, for the micro-app-builder skill.
PLATFORM_APP_BUILDER_MCP_URL=https://your-app-builder-connection-link.example/mcp
